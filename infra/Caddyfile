{
	# Plain HTTP inside the container. For a public deployment put a TLS terminator
	# (or a Caddy TLS site block) in front; this file must not assume `localhost`
	# resolves inside the compose network.
	admin off
}

:8080 {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		X-Frame-Options DENY
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# API traffic goes through the Next.js route handler, which injects the
	# server-side bearer token. Do not proxy /api straight to the API: the browser
	# must never hold EZCHAIN_API_TOKEN.
	handle /api/* {
		reverse_proxy web:3000
	}

	# Liveness and readiness are the only API endpoints published at the edge.
	handle /healthz {
		reverse_proxy api:8000
	}
	handle /readyz {
		reverse_proxy api:8000
	}

	# Operational surfaces stay off the public edge. The API already refuses them to a
	# non-loopback caller without the operator token; this makes the edge itself answer
	# 404, so a future web route can never publish them by accident. Scrape the API over
	# the Docker network (or an operator tunnel) instead.
	@operational path /metrics /health /docs /docs/* /redoc /redoc/* /openapi.json
	handle @operational {
		respond 404
	}

	# Everything else is the product UI.
	handle {
		reverse_proxy web:3000
	}

	# The FastAPI OpenAPI UI is intentionally not published. On a trusted machine,
	# run the API and web locally (tools/dev.sh) or scrape the API over the Docker
	# network; do not add an edge handler for /docs or /openapi.json.
}
