# ezCHAIN infra environment. Copy to .env — never commit .env.
# Every required value fails startup with the exact key name if missing.

# --- core ---------------------------------------------------------------
EZCHAIN_ENV=local                 # local | production
EZCHAIN_VERSION=0.1.0
EZCHAIN_DOMAIN=localhost
EZCHAIN_BIND=127.0.0.1
EZCHAIN_PORT=8080
EZCHAIN_PUBLIC_URL=http://localhost:8080
EZCHAIN_LOG_LEVEL=info

# --- database -----------------------------------------------------------
POSTGRES_DB=ezchain
POSTGRES_USER=ezchain
POSTGRES_PASSWORD=change-me-long-random
DATABASE_URL=postgresql+asyncpg://ezchain:change-me-long-random@postgres:5432/ezchain

# --- cache / bus --------------------------------------------------------
REDIS_URL=redis://redis:6379/0
NATS_URL=nats://nats:4222

# --- auth / vault -------------------------------------------------------
# 32 random bytes, base64. Generate: openssl rand -base64 32
EZCHAIN_VAULT_KEY=
EZCHAIN_SESSION_SECRET=
EZCHAIN_PUBLIC_URL_FOR_WEBAUTHN=http://localhost:8080

# --- chain providers (optional; public defaults are used if empty) ------
HELIUS_API_KEY=
TRITON_RPC_URL=
EVM_RPC_ETHEREUM=
EVM_RPC_BASE=
EVM_RPC_ARBITRUM=
EVM_RPC_POLYGON=
EVM_RPC_BNB=

# --- venues (optional) --------------------------------------------------
ONEINCH_API_KEY=
JUPITER_API_URL=https://lite-api.jup.ag/swap/v1

# --- exchange keys: prefer vault: references, not raw env --------------
# BINANCE_API_KEY=vault:binance/api_key

# --- observability ------------------------------------------------------
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAMESPACE=ezchain
PROMETHEUS_URL=http://prometheus:9090
