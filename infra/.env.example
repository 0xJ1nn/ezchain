# ezCHAIN PAPER stack environment.
# Copy to infra/.env and edit the two required secrets. Never commit the copy.
#
#   cp infra/.env.example infra/.env
#   openssl rand -hex 32   # POSTGRES_PASSWORD (run twice: once for the token)
#
# Compose reads this file for ${...} interpolation AND passes it to the api/web
# containers. The database URL is built by compose from POSTGRES_USER/PASSWORD/DB;
# do not duplicate it here.

# --- required secrets ----------------------------------------------------
POSTGRES_PASSWORD=replace-with-a-long-random-password

# Shared bearer token for /api/*. At least 32 characters; 64 hex characters is ideal.
#   openssl rand -hex 32
# The web container injects it server-side; it is never sent to the browser.
EZCHAIN_API_TOKEN=

# --- edge ----------------------------------------------------------------
# Public origin used for links and the proxy's same-origin check. It must match the
# browser-visible origin, including scheme and port (http://localhost:8080 by default).
EZCHAIN_PUBLIC_URL=http://localhost:8080
EZCHAIN_DOMAIN=localhost
# Bind to 127.0.0.1 for a single-machine install. Use 0.0.0.0 only behind a
# firewall or a TLS reverse proxy.
EZCHAIN_BIND=127.0.0.1
EZCHAIN_PORT=8080
# Local image tag used by compose (`ezchain/api:<tag>`, `ezchain/web:<tag>`).
EZCHAIN_VERSION=local

# --- database ------------------------------------------------------------
POSTGRES_DB=ezchain
POSTGRES_USER=ezchain

# --- API / runtime -------------------------------------------------------
EZCHAIN_ENVIRONMENT=prod
# Schema is owned by the one-shot `migrate` service. The API must not create tables.
EZCHAIN_AUTO_CREATE_SCHEMA=false
EZCHAIN_AUTH_ENABLED=true
EZCHAIN_LOG_LEVEL=INFO
EZCHAIN_DATA_MODE=live

# The engine and market scanner run inside the API process in PAPER.
EZCHAIN_ENGINE_INLINE=true
EZCHAIN_ENGINE_INTERVAL_SECONDS=30
EZCHAIN_MARKET_SCAN_INLINE=true
EZCHAIN_MARKET_SCAN_INTERVAL_SECONDS=90
EZCHAIN_MARKET_SCAN_LIMIT=200

# Same-origin browser requests through Caddy do not need CORS, but keep the
# local edge origins explicit for direct API tooling.
EZCHAIN_CORS_ORIGINS=["http://localhost:8080","http://127.0.0.1:8080"]

# --- web -----------------------------------------------------------------
# Server-side API base. The browser talks to Next.js, not to this address.
EZCHAIN_API_URL=http://api:8000
# live | fixture. Fixture mode is for Playwright and offline UI work only.
EZCHAIN_WEB_MODE=live

# --- paper limits (optional; unset values come from the API config) ------
# apps/api/src/ezchain_api/config.py is the single home for these defaults.
# EZCHAIN_PAPER_STARTING_CASH_USD=10000
# EZCHAIN_PAPER_FEE_BPS=30
# EZCHAIN_MAX_ORDER_USD=1000
# EZCHAIN_MAX_POSITION_USD=2500
# EZCHAIN_MAX_OPEN_POSITIONS=10
# EZCHAIN_MAX_DAILY_LOSS_USD=500
# EZCHAIN_MIN_PAIR_AGE_MINUTES=10

# --- observability profile (optional) ------------------------------------
# The profile includes Prometheus, which scrapes api:8000/metrics, and an optional
# Grafana with no provisioned dashboards. Set a password before using Grafana.
# EZCHAIN_GRAFANA_ADMIN_PASSWORD=

