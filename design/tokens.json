{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "ezCHAIN provisional tokens",
  "note": "Provisional M1 tokens derived from the wireframe palette. The visual pass in design/BRIEF.md may replace values; structure must survive.",
  "color": {
    "surface": {
      "canvas": "#f2f2ef",
      "raised": "#ffffff",
      "overlay": "#ffffff",
      "sunken": "#f0f0ec",
      "subtle": "#fafaf8",
      "hairline": "#d9d9d2",
      "borderStrong": "#b9b9b1"
    },
    "text": {
      "primary": "#161615",
      "secondary": "#3c3c39",
      "muted": "#6f6f68",
      "disabled": "#a3a39a",
      "inverse": "#ffffff"
    },
    "semantic": {
      "success": { "text": "#23663f", "bg": "#e8f2ea", "border": "#b7cfbc" },
      "danger": { "text": "#99302c", "bg": "#f8e9e7", "border": "#dfb9b4" },
      "warning": { "text": "#7d5600", "bg": "#f6efdc", "border": "#ddc99a" },
      "info": { "text": "#244f73", "bg": "#e8eef4", "border": "#b8c9da" },
      "neutral": { "text": "#3c3c39", "bg": "#fafaf8", "border": "#d9d9d2" }
    },
    "accent": {
      "primary": "#161615",
      "hover": "#333333",
      "active": "#000000",
      "focus": "#244f73",
      "secondary": "#244f73"
    },
    "chart": {
      "grid": "#e6e6df",
      "axis": "#b9b9b1",
      "series1": "#161615",
      "series2": "#23663f",
      "series3": "#99302c",
      "series4": "#244f73",
      "series5": "#7d5600",
      "series6": "#6f6f68",
      "entry": "#161615",
      "stop": "#99302c",
      "trail": "#244f73",
      "level": "#b9b9b1"
    }
  },
  "dark": {
    "color": {
      "surface": {
        "canvas": "#121417",
        "raised": "#181b1e",
        "overlay": "#1e2023",
        "sunken": "#0e1011",
        "subtle": "#14171a",
        "hairline": "#2a2e33",
        "borderStrong": "#3a3f46"
      },
      "text": {
        "primary": "#f2f2ef",
        "secondary": "#c9c9c2",
        "muted": "#a1a199",
        "disabled": "#6b6e6a",
        "inverse": "#161615"
      },
      "semantic": {
        "success": { "text": "#8fe3b6", "bg": "#13251b", "border": "#2e4a38" },
        "danger": { "text": "#f2a6a0", "bg": "#2b1a1a", "border": "#5a3330" },
        "warning": { "text": "#f0c97a", "bg": "#2a2110", "border": "#5a4a1f" },
        "info": { "text": "#9ccbef", "bg": "#152030", "border": "#2e4a5f" },
        "neutral": { "text": "#c9c9c2", "bg": "#1a1d20", "border": "#33373d" }
      },
      "accent": {
        "primary": "#e8b04b",
        "hover": "#f0c065",
        "active": "#c9973a",
        "focus": "#f5d08c",
        "secondary": "#8fc3f0"
      },
      "chart": {
        "grid": "#232629",
        "axis": "#3a3f46",
        "series1": "#f2f2ef",
        "series2": "#6fd3a0",
        "series3": "#f29a94",
        "series4": "#8fc3f0",
        "series5": "#f0c97a",
        "series6": "#a1a199",
        "entry": "#f2f2ef",
        "stop": "#f29a94",
        "trail": "#8fc3f0",
        "level": "#4a4f56"
      }
    }
  },
  "space": {
    "0": "0px",
    "1": "4px",
    "2": "8px",
    "3": "12px",
    "4": "16px",
    "6": "24px",
    "8": "32px",
    "12": "48px"
  },
  "radius": {
    "xs": "2px",
    "sm": "3px",
    "md": "6px",
    "lg": "10px",
    "pill": "999px"
  },
  "type": {
    "family": {
      "sans": "\"Inter\", \"Segoe UI\", system-ui, -apple-system, sans-serif",
      "mono": "\"IBM Plex Mono\", \"JetBrains Mono\", ui-monospace, \"SFMono-Regular\", Consolas, monospace"
    },
    "size": {
      "micro": "10px",
      "small": "11px",
      "body": "13px",
      "label": "12px",
      "title": "15px",
      "heading": "19px",
      "display": "30px"
    },
    "lineHeight": {
      "tight": "1.2",
      "body": "1.45",
      "loose": "1.6"
    },
    "tracking": {
      "micro": "0.04em",
      "label": "0.08em",
      "heading": "-0.015em"
    }
  },
  "elevation": {
    "0": "0 1px 0 rgba(0, 0, 0, 0.04)",
    "1": "0 4px 12px rgba(0, 0, 0, 0.08)",
    "2": "0 12px 32px rgba(0, 0, 0, 0.16)"
  },
  "motion": {
    "fast": "120ms",
    "base": "180ms",
    "slow": "240ms",
    "easing": "cubic-bezier(0.2, 0, 0, 1)"
  }
}
