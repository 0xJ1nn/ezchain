  "ezchain_chart_spec": {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": true,
      "openWorldHint": true,
      "readOnlyHint": true
    },
    "description": "Declarative line-chart spec (axes, series, overlays, source and age) for the web UI. No image generation and no new chart library.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "chain": {
          "type": "string"
        },
        "overlays": {
          "default": [],
          "items": {
            "enum": [
              "sma",
              "ema"
            ],
            "type": "string"
          },
          "type": "array"
        },
        "token": {
          "type": "string"
        },
        "window": {
          "enum": [
            "1h",
            "4h",
            "1d",
            "7d"
          ],
          "type": "string"
        }
      },
      "required": [
        "chain",
        "token",
        "window"
      ],
      "type": "object"
    },
    "name": "ezchain_chart_spec",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "age_seconds": {
          "type": [
            "integer",
            "null"
          ]
        },
        "arithmetic": {
          "type": "string"
        },
        "axes": {
          "type": "object"
        },
        "chain": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "overlays": {
          "items": {
            "type": "object"
          },
          "type": "array"
        },
        "series": {
          "items": {
            "type": "object"
          },
          "type": "array"
        },
        "source": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "name": {
                  "type": "string"
                },
                "observed_at": {
                  "type": "string"
                },
                "url": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "name",
                "observed_at"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "spec_version": {
          "type": "integer"
        },
        "stale": {
          "type": "boolean"
        },
        "timeframe": {
          "type": "string"
        },
        "token": {
          "type": "string"
        },
        "window": {
          "enum": [
            "1h",
            "4h",
            "1d",
            "7d"
          ],
          "type": "string"
        }
      },
      "required": [
        "spec_version",
        "kind",
        "chain",
        "token",
        "window",
        "timeframe",
        "axes",
        "series",
        "overlays",
        "age_seconds",
        "stale",
        "arithmetic"
      ],
      "type": "object"
    },
