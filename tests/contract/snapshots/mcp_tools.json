    "title": "Chart spec",
    "traceEvent": "tool_call"
  },
  "ezchain_create_protection_profile": {
    "annotations": {
      "destructiveHint": false,
      "idempotentHint": false,
      "openWorldHint": true,
      "readOnlyHint": false
    },
    "description": "Create a reusable manual protection profile through the existing API. Percentages are sent as exact decimal strings. It never arms protection or places an order; dry_run previews the request without persisting it.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "dry_run": {
          "default": false,
          "type": "boolean"
        },
        "name": {
          "type": "string"
        },
        "stop_loss_pct": {
          "type": [
            "number",
            "string"
          ]
        },
        "take_profit_pct": {
          "type": [
            "number",
            "string"
          ]
        },
        "trailing_pct": {
          "type": [
            "number",
            "string"
          ]
        }
      },
      "required": [
        "name"
      ],
      "type": "object"
    },
    "name": "ezchain_create_protection_profile",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "dry_run": {
          "type": "boolean"
        },
        "persisted": {
          "type": "boolean"
        },
        "profile": {
          "anyOf": [
            {
              "additionalProperties": false,
              "properties": {
                "chain": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "created_at": {
                  "type": "string"
                },
                "id": {
                  "type": "string"
                },
                "kind": {
                  "type": "string"
                },
                "mode": {
                  "type": "string"
                },
                "name": {
                  "type": "string"
                },
                "rules": {
                  "items": {
                    "type": "string"
                  },
                  "type": "array"
                },
                "stop_loss_pct": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "take_profit_pct": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "trailing_pct": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "updated_at": {
                  "type": "string"
                }
              },
              "required": [
                "id",
                "name",
                "kind",
                "created_at",
                "updated_at"
              ],
              "type": "object"
            },
            {
              "type": "null"
            }
          ]
        },
        "request": {
          "type": "object"
        }
      },
      "required": [
        "dry_run",
        "persisted",
        "request"
      ],
      "type": "object"
    },
    "scope": "trade",
    "title": "Create protection profile",
    "traceEvent": "tool_call"
  },
