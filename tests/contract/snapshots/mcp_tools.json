          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "params": {
          "type": "object"
        },
        "plugin_id": {
          "type": "string"
        },
        "status": {
          "enum": [
            "active",
            "paused"
          ],
          "type": "string"
        },
        "token_address": {
          "type": "string"
        },
        "token_symbol": {
          "type": "string"
        }
      },
      "required": [
        "name",
        "chain",
        "token_address",
        "token_symbol",
        "kind"
      ],
      "type": "object"
    },
