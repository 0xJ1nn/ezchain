<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Inherited entitlements for the child processes the macOS build signs: the Electron helper
  processes and the frozen API sidecar.

  `com.apple.security.inherit` means "take the parent's entitlements"; Apple only allows it on
  a child, and rejects it in the main app's entitlements. It is the reason this file exists
  next to `entitlements.mac.plist` rather than the two being one file.

  The sidecar is a plain PyInstaller executable, not a JIT runtime, so nothing here grants
  JIT to it directly; it inherits from the app, which does. If a macOS build is ever taken to
  the point of passing notarisation and launch, this file is one of the things that has to be
  re-read: an entitlement that is present but not needed is a review finding, not a
  precaution.
-->
<plist version="1.0">
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.inherit</key>
    <true/>
  </dict>
</plist>
