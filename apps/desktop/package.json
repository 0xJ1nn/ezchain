{
  "name": "@ezchain/desktop",
  "version": "0.1.0",
  "private": true,
  "description": "ezCHAIN native desktop shell (Linux, macOS, Windows)",
  "main": "main.cjs",
  "scripts": {
    "start": "electron .",
    "dist:dir": "electron-builder --linux dir",
    "dist:linux": "electron-builder --linux AppImage deb",
    "dist:mac": "electron-builder --mac dmg zip",
    "dist:win": "electron-builder --win nsis portable",
    "test": "node --test \"test/*.mjs\""
  },
  "devDependencies": {
    "@electron/fuses": "1.8.0",
    "electron": "45.0.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "io.ezchain.workstation",
    "productName": "ezCHAIN",
    "asar": true,
    "directories": {
      "output": "dist",
      "buildResources": "resources"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "sender.js",
      "platform.js",
      "package.json"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "onlyLoadAppFromAsar": true
    },
    "extraResources": [
      {
        "from": "build/backend",
        "to": "backend"
      },
      {
        "from": "build/web.tar.gz",
        "to": "web.tar.gz"
      },
      {
        "from": "resources/icon.png",
        "to": "icon.png"
      },
      {
        "from": "../../LICENSE",
        "to": "LICENSE"
      }
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Finance",
      "icon": "resources/icon.png",
      "artifactName": "ezCHAIN-${version}-${arch}.${ext}",
      "maintainer": "ezCHAIN contributors <0xJ1nn@users.noreply.github.com>",
      "syncDesktopName": true,
      "executableArgs": []
    },
    "deb": {
      "depends": [
        "libgtk-3-0",
        "libnotify4",
        "libnss3",
        "libxss1",
        "libxtst6",
        "xdg-utils",
        "libatspi2.0-0",
        "libayatana-appindicator3-1"
      ]
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "category": "public.app-category.finance",
      "icon": "resources/icon.png",
      "artifactName": "ezCHAIN-${version}-${arch}.${ext}",
      "hardenedRuntime": true,
      "entitlements": "resources/entitlements.mac.plist",
      "entitlementsInherit": "resources/entitlements.mac.inherit.plist",
      "extendInfo": {
        "LSUIElement": false,
        "NSHumanReadableCopyright": "AGPL-3.0-or-later · ezCHAIN contributors"
      }
    },
    "dmg": {
      "title": "ezCHAIN ${version}",
      "contents": [
        {
          "x": 140,
          "y": 200
        },
        {
          "x": 400,
          "y": 200,
          "type": "link",
          "path": "/Applications"
        }
      ]
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        "portable"
      ],
      "icon": "resources/icon.png",
      "artifactName": "ezCHAIN-${version}-${arch}.${ext}",
      "publisherName": "ezCHAIN contributors"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ezCHAIN",
      "deleteAppDataOnUninstall": false
    },
    "executableName": "ezchain"
  },
  "author": {
    "name": "ezCHAIN contributors",
    "email": "0xJ1nn@users.noreply.github.com"
  },
  "homepage": "https://github.com/0xJ1nn/ezchain",
  "desktopName": "ezchain.desktop",
  "license": "AGPL-3.0-or-later"
}
