# Copy to ~/.config/ezchain/agent.env and chmod 600.
# Use a scoped key from POST /api/v1/agent/keys, not the deployment admin token.
EZCHAIN_API_URL=https://ezchain.example.com
# Optional: absolute path to the ezchain-mcp executable if it is not on PATH.
# EZCHAIN_MCP_BIN=/home/you/.venv/bin/ezchain-mcp
EZCHAIN_API_TOKEN=ezk_replace_with_a_read_or_trade_key
# Omit for read-only. Writes still require the key's trade scope.
EZCHAIN_MCP_ALLOW_WRITES=1
