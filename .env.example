# ezCHAIN local configuration. Copy to .env; never commit the copy.
# The API reads EZCHAIN_*; the web reads EZCHAIN_API_URL.

EZCHAIN_DATABASE_URL=postgresql+psycopg://jinultimate@localhost:5432/ezchain
EZCHAIN_DATA_MODE=live
EZCHAIN_ENGINE_INLINE=true
EZCHAIN_ENGINE_INTERVAL_SECONDS=30
# Continuous all-chain market observation. Interval is bounded to >=30s.
EZCHAIN_MARKET_SCAN_INLINE=true
EZCHAIN_MARKET_SCAN_INTERVAL_SECONDS=90
EZCHAIN_MARKET_SCAN_LIMIT=200
EZCHAIN_PAPER_STARTING_CASH_USD=10000
EZCHAIN_PAPER_FEE_BPS=30
EZCHAIN_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Next.js proxies /api/* here. Use 127.0.0.1, not localhost, to avoid IPv6 surprises.
EZCHAIN_API_URL=http://127.0.0.1:8000
