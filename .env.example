# ezCHAIN local configuration. Copy to .env; never commit the copy.
# The API reads EZCHAIN_*; the web reads EZCHAIN_API_URL and, server-side only,
# EZCHAIN_API_TOKEN.

EZCHAIN_ENVIRONMENT=dev
EZCHAIN_DATABASE_URL=postgresql+psycopg://localhost:5432/ezchain
EZCHAIN_DATA_MODE=live
# Server-derived. "live" is refused until the executor ships.
EZCHAIN_EXECUTION_MODE=paper
# Dev/test only. Prod must set this false and run migrations explicitly.
EZCHAIN_AUTO_CREATE_SCHEMA=true
EZCHAIN_LOG_LEVEL=INFO

# --- auth ---------------------------------------------------------------
# Mutating /api routes need "Authorization: Bearer $EZCHAIN_API_TOKEN".
# Generate with: openssl rand -hex 32
# Leave empty in local dev to allow mutations with one startup warning.
# Prod refuses to start unless this is at least 32 characters.
EZCHAIN_PUBLIC_URL=http://localhost:8080
EZCHAIN_API_TOKEN=
EZCHAIN_AUTH_ENABLED=true
# Hosted/agent deployments: require a scoped key even for reads under /api.
EZCHAIN_REQUIRE_AUTH_FOR_READS=false
# >=32 random bytes; required before minting agent keys in production.
# openssl rand -hex 32
EZCHAIN_API_KEY_PEPPER=
EZCHAIN_AGENT_KEY_DEFAULT_TTL_DAYS=90

# --- strategy plugins ---------------------------------------------------
# Comma-separated directories containing ezchain.plugin.json or child packages with one.
# Installed packages are discovered through the "ezchain.strategies" entry point.
EZCHAIN_PLUGIN_PATHS=
EZCHAIN_PLUGIN_TIMEOUT_SECONDS=5
EZCHAIN_PLUGIN_MEMORY_MB=512
EZCHAIN_PLUGIN_CPU_SECONDS=10

EZCHAIN_ENGINE_INLINE=true
EZCHAIN_ENGINE_INTERVAL_SECONDS=30
# Continuous all-chain market observation. Interval is bounded to >=30s.
EZCHAIN_MARKET_SCAN_INLINE=true
EZCHAIN_MARKET_SCAN_INTERVAL_SECONDS=90
EZCHAIN_MARKET_SCAN_LIMIT=200
EZCHAIN_PAPER_STARTING_CASH_USD=10000
EZCHAIN_MIN_PAIR_AGE_MINUTES=10
EZCHAIN_PAPER_FEE_BPS=30
# Execution-cost ceiling for a new position, as a ratio (0.05 = 5%). Gates buys with an
# executable quote only: a DexScreener mark reports no impact and a sell is never blocked.
EZCHAIN_MAX_PRICE_IMPACT_PCT=0.05
# --- trade sizing --------------------------------------------------------
# Boot defaults for the persisted policy at /api/v1/settings/trade-policy. The workspace
# envelope is a hard outer bound; each low/mid/high profile may only tighten it. Every
# profile has the same four keys (min amount, min % equity, max amount, max % equity).
EZCHAIN_TRADE_DEFAULT_PROFILE=mid
EZCHAIN_TRADE_MIN_AMOUNT_USD=10
EZCHAIN_TRADE_MIN_PCT_EQUITY=0.10
EZCHAIN_TRADE_MAX_AMOUNT_USD=1000
EZCHAIN_TRADE_MAX_PCT_EQUITY=5
EZCHAIN_TRADE_LOW_MIN_AMOUNT_USD=10
EZCHAIN_TRADE_LOW_MIN_PCT_EQUITY=0.10
EZCHAIN_TRADE_LOW_MAX_AMOUNT_USD=50
EZCHAIN_TRADE_LOW_MAX_PCT_EQUITY=1
EZCHAIN_TRADE_MID_MIN_AMOUNT_USD=10
EZCHAIN_TRADE_MID_MIN_PCT_EQUITY=0.10
EZCHAIN_TRADE_MID_MAX_AMOUNT_USD=150
EZCHAIN_TRADE_MID_MAX_PCT_EQUITY=2
EZCHAIN_TRADE_HIGH_MIN_AMOUNT_USD=10
EZCHAIN_TRADE_HIGH_MIN_PCT_EQUITY=0.10
EZCHAIN_TRADE_HIGH_MAX_AMOUNT_USD=500
EZCHAIN_TRADE_HIGH_MAX_PCT_EQUITY=5
EZCHAIN_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Next.js proxies browser /api/* through its server route to this URL.
# Use 127.0.0.1, not localhost, to avoid IPv6 surprises.
EZCHAIN_API_URL=http://127.0.0.1:8000
# Server-side only: injected by the Next proxy, never sent to the browser.
# EZCHAIN_API_TOKEN is defined above and shared by the API and web server.

# --- MCP agents (apps/mcp) ---------------------------------------------
# Read-only by default. Writes additionally need the API bearer token above.
# EZCHAIN_MCP_ALLOW_WRITES=1
